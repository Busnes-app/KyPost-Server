# Functions CI's deadcode check (.github/workflows/ci.yml) accepts as
# unreachable from cmd/. Every other unreachable function fails the build:
# delete it, or move test-only code into a _test.go file or a *test package.
#
# Each entry here is a hook another package's tests call to reach this
# package's unexported state. A _test.go file is visible only to its own
# package, and a helper package would need that state exported, so the hook has
# to live in a production file. Keep it that way only while that is true.

# Lowers Argon2id cost for test suites; panics outside a test binary.
github.com/Busnes-app/kypost-server/backend/internal/users.SetHashParamsForTest
github.com/Busnes-app/kypost-server/backend/internal/users.HashParams

# Lowers PBKDF2 cost for other packages' test suites; panics outside tests.
github.com/Busnes-app/kypost-server/backend/internal/users.SetLoginIterationsForTest

# Trusts httptest's TLS certificate for the ssotest provider; panics outside a
# test binary.
github.com/Busnes-app/kypost-server/backend/internal/sso.SetTransport

# Writes version-1 native files for migration and backup tests; panics outside
# a test binary.
github.com/Busnes-app/kypost-server/backend/internal/sso.WriteNativeV1ForTest

# Points the Ollama release check at an httptest server for api's tests.
github.com/Busnes-app/kypost-server/backend/internal/ollamaupdate.SetReleasesURLForTest

# Marks a test pairing as KyIdentity's for api's per-user default tests;
# panics outside a test binary.
github.com/Busnes-app/kypost-server/backend/internal/kycalendar.NewKyIdentityForTest

# Writes a v3 native-authority.db fixture plus both stubs for sso and backup
# tests; panics outside a test binary. The pure v2 → v3 converter and writer
# it calls are the inputs of the v3 migration (docs/NATIVE_AUTHORITY_PER_ACCOUNT.md
# PR 3); drop these entries when migrate-native calls them.
github.com/Busnes-app/kypost-server/backend/internal/sso.WriteNativeAuthorityV3ForTest
github.com/Busnes-app/kypost-server/backend/internal/sso.authorityV3Rows
github.com/Busnes-app/kypost-server/backend/internal/sso.flag
github.com/Busnes-app/kypost-server/backend/internal/sso.writeAuthorityV3
